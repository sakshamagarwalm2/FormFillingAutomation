SESSION_TIMEOUT=

PORT=

# Options: groq, openai, github
AI_PROVIDER=github

# For Groq: llama-3.3-70b-versatile, llama-3.1-70b-versatile, mixtral-8x7b-32768
# For OpenAI: gpt-4, gpt-4-turbo, gpt-3.5-turbo, gpt-4o, gpt-4o-mini
# For GitHub: openai/gpt-4.1
MODEL_NAME=openai/gpt-4.1

# AI Model Temperature (0.0 to 1.0)
TEMPERATURE=0.1

# API Keys (only include the ones you need)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE